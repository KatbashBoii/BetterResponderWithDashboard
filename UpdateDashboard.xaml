  <Sequence DisplayName="UpdateDashboard" sap2010:Annotation.AnnotationText="Writes bot activity to dashboard\data\bot-data.json and bot-data.js so dashboard\index.html can show it in the browser. Errors here never stop the bot." sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="summary" />
    </Sequence.Variables>
    <If Condition="[Not String.IsNullOrWhiteSpace(in_Message)]" DisplayName="If there is a message" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <WriteLine DisplayName="Show step in Output panel" sap2010:WorkflowViewState.IdRef="WriteLine_1" Text="[If(String.IsNullOrWhiteSpace(in_TicketId), &quot;&quot;, &quot;[&quot; + in_TicketId + &quot;] &quot;) + in_Message]" />
      </If.Then>
    </If>
    <TryCatch DisplayName="Try Catch" sap2010:WorkflowViewState.IdRef="TryCatch_1">
      <TryCatch.Try>
        <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ===== UpdateDashboard: writes everything the bot does to dashboard\data\bot-data.json (+ bot-data.js for the browser) =====&#xA;' in_Kind    : &quot;runStart&quot; | &quot;runEnd&quot; | &quot;email&quot; | &quot;event&quot; | &quot;rules&quot;&#xA;' in_Fields  : values to store. A key named &quot;sent&quot; (a Dictionary) is stored as an outgoing email in the Sent Mail list.&#xA;' in_Message : optional line for the Live activity feed. in_Level colours it (info, spam, urgent, ai, route, reply, skip, run, error).&#xA;out_Summary = &quot;&quot;&#xA;Dim dataDir As String = System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;dashboard&quot;, &quot;data&quot;)&#xA;System.IO.Directory.CreateDirectory(dataDir)&#xA;Dim jsonPath As String = System.IO.Path.Combine(dataDir, &quot;bot-data.json&quot;)&#xA;Dim jsPath As String = System.IO.Path.Combine(dataDir, &quot;bot-data.js&quot;)&#xA;&#xA;' 1. Load the existing history (or start an empty one)&#xA;Dim data As Newtonsoft.Json.Linq.JObject = Nothing&#xA;If System.IO.File.Exists(jsonPath) Then&#xA;    Try&#xA;        data = Newtonsoft.Json.Linq.JObject.Parse(System.IO.File.ReadAllText(jsonPath))&#xA;    Catch&#xA;        System.IO.File.Copy(jsonPath, jsonPath &amp; &quot;.broken-&quot; &amp; DateTime.Now.ToString(&quot;yyyyMMddHHmmss&quot;), True)&#xA;        data = Nothing&#xA;    End Try&#xA;End If&#xA;If data Is Nothing Then data = New Newtonsoft.Json.Linq.JObject()&#xA;For Each listName As String In New String() {&quot;runs&quot;, &quot;emails&quot;, &quot;events&quot;, &quot;sent&quot;}&#xA;    If data(listName) Is Nothing OrElse data(listName).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Array Then&#xA;        data(listName) = New Newtonsoft.Json.Linq.JArray()&#xA;    End If&#xA;Next&#xA;Dim runs As Newtonsoft.Json.Linq.JArray = CType(data(&quot;runs&quot;), Newtonsoft.Json.Linq.JArray)&#xA;Dim emails As Newtonsoft.Json.Linq.JArray = CType(data(&quot;emails&quot;), Newtonsoft.Json.Linq.JArray)&#xA;Dim events As Newtonsoft.Json.Linq.JArray = CType(data(&quot;events&quot;), Newtonsoft.Json.Linq.JArray)&#xA;Dim sent As Newtonsoft.Json.Linq.JArray = CType(data(&quot;sent&quot;), Newtonsoft.Json.Linq.JArray)&#xA;&#xA;Dim nowText As String = DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)&#xA;Dim kind As String = If(in_Kind, &quot;&quot;).Trim()&#xA;Dim runKey As String = If(in_RunId, &quot;&quot;)&#xA;Dim ticketKey As String = If(in_TicketId, &quot;&quot;)&#xA;&#xA;' 2. Convert the incoming values to JSON (DataTables become lists of rows)&#xA;Dim toJson As System.Func(Of Object, Newtonsoft.Json.Linq.JToken) =&#xA;    Function(v As Object) As Newtonsoft.Json.Linq.JToken&#xA;        If v Is Nothing Then Return Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;        If TypeOf v Is System.Data.DataTable Then&#xA;            Dim dt As System.Data.DataTable = CType(v, System.Data.DataTable)&#xA;            Dim rows As New Newtonsoft.Json.Linq.JArray()&#xA;            For Each r As System.Data.DataRow In dt.Rows&#xA;                Dim o As New Newtonsoft.Json.Linq.JObject()&#xA;                Dim hasValue As Boolean = False&#xA;                For Each c As System.Data.DataColumn In dt.Columns&#xA;                    Dim cell As String = If(r.IsNull(c), &quot;&quot;, r(c).ToString().Trim())&#xA;                    If cell &lt;&gt; &quot;&quot; Then hasValue = True&#xA;                    o(c.ColumnName) = New Newtonsoft.Json.Linq.JValue(cell)&#xA;                Next&#xA;                If hasValue Then rows.Add(o)&#xA;            Next&#xA;            Return rows&#xA;        End If&#xA;        If TypeOf v Is Boolean OrElse TypeOf v Is Integer OrElse TypeOf v Is Long OrElse TypeOf v Is Double Then&#xA;            Return Newtonsoft.Json.Linq.JToken.FromObject(v)&#xA;        End If&#xA;        Return New Newtonsoft.Json.Linq.JValue(v.ToString())&#xA;    End Function&#xA;&#xA;Dim fields As New Newtonsoft.Json.Linq.JObject()&#xA;Dim sentMail As Newtonsoft.Json.Linq.JObject = Nothing&#xA;If in_Fields IsNot Nothing Then&#xA;    For Each kv As System.Collections.Generic.KeyValuePair(Of String, Object) In in_Fields&#xA;        If kv.Key = &quot;sent&quot; AndAlso TypeOf kv.Value Is System.Collections.Generic.IDictionary(Of String, Object) Then&#xA;            sentMail = New Newtonsoft.Json.Linq.JObject()&#xA;            For Each skv As System.Collections.Generic.KeyValuePair(Of String, Object) In CType(kv.Value, System.Collections.Generic.IDictionary(Of String, Object))&#xA;                sentMail(skv.Key) = toJson(skv.Value)&#xA;            Next&#xA;        Else&#xA;            fields(kv.Key) = toJson(kv.Value)&#xA;        End If&#xA;    Next&#xA;End If&#xA;&#xA;' 3. Store the update in the right list&#xA;Select Case kind&#xA;    Case &quot;runStart&quot;&#xA;        Dim newRun As New Newtonsoft.Json.Linq.JObject()&#xA;        newRun(&quot;runId&quot;) = runKey&#xA;        newRun(&quot;startedAt&quot;) = nowText&#xA;        newRun(&quot;status&quot;) = &quot;Running&quot;&#xA;        newRun(&quot;machine&quot;) = System.Environment.MachineName&#xA;        newRun(&quot;user&quot;) = System.Environment.UserName&#xA;        runs.Add(newRun)&#xA;    Case &quot;runEnd&quot;&#xA;        Dim endRun As Newtonsoft.Json.Linq.JObject = Nothing&#xA;        For Each t As Newtonsoft.Json.Linq.JToken In runs&#xA;            If t.Value(Of String)(&quot;runId&quot;) = runKey Then endRun = CType(t, Newtonsoft.Json.Linq.JObject)&#xA;        Next&#xA;        If endRun Is Nothing Then&#xA;            endRun = New Newtonsoft.Json.Linq.JObject()&#xA;            endRun(&quot;runId&quot;) = runKey&#xA;            runs.Add(endRun)&#xA;        End If&#xA;        endRun(&quot;endedAt&quot;) = nowText&#xA;        For Each p As Newtonsoft.Json.Linq.JProperty In fields.Properties()&#xA;            endRun(p.Name) = p.Value&#xA;        Next&#xA;        ' Summary of this run for the UiPath Output panel&#xA;        Dim nRead As Integer = 0&#xA;        Dim nHelp As Integer = 0&#xA;        Dim nSpam As Integer = 0&#xA;        Dim nUrgent As Integer = 0&#xA;        Dim nKeyword As Integer = 0&#xA;        Dim nReplied As Integer = 0&#xA;        Dim nFallback As Integer = 0&#xA;        Dim nForward As Integer = 0&#xA;        Dim deptText As New System.Text.StringBuilder()&#xA;        For Each em As Newtonsoft.Json.Linq.JToken In emails&#xA;            If em.Value(Of String)(&quot;runId&quot;) = runKey Then&#xA;                nRead = nRead + 1&#xA;                Dim st As String = If(em.Value(Of String)(&quot;status&quot;), &quot;&quot;)&#xA;                Dim kw As String = If(em.Value(Of String)(&quot;keyword&quot;), &quot;&quot;)&#xA;                Dim dept As String = If(em.Value(Of String)(&quot;department&quot;), &quot;&quot;)&#xA;                If em(&quot;isHelpDesk&quot;) IsNot Nothing AndAlso em(&quot;isHelpDesk&quot;).ToString().ToLower() = &quot;true&quot; Then nHelp = nHelp + 1&#xA;                If em(&quot;isSpam&quot;) IsNot Nothing AndAlso em(&quot;isSpam&quot;).ToString().ToLower() = &quot;true&quot; Then nSpam = nSpam + 1&#xA;                If em(&quot;isUrgent&quot;) IsNot Nothing AndAlso em(&quot;isUrgent&quot;).ToString().ToLower() = &quot;true&quot; Then nUrgent = nUrgent + 1&#xA;                If kw &lt;&gt; &quot;&quot; AndAlso kw.ToLower() &lt;&gt; &quot;none&quot; Then nKeyword = nKeyword + 1&#xA;                If st.ToLower().Contains(&quot;repl&quot;) Then nReplied = nReplied + 1&#xA;                If st.ToLower().Contains(&quot;no keyword&quot;) OrElse st.ToLower().Contains(&quot;not help desk&quot;) Then nFallback = nFallback + 1&#xA;                If If(em.Value(Of String)(&quot;routedTo&quot;), &quot;&quot;) &lt;&gt; &quot;&quot; Then&#xA;                    nForward = nForward + 1&#xA;                    If dept &lt;&gt; &quot;&quot; Then deptText.Append(If(deptText.Length &gt; 0, &quot;, &quot;, &quot;&quot;) &amp; dept)&#xA;                End If&#xA;            End If&#xA;        Next&#xA;        Dim nl As String = System.Environment.NewLine&#xA;        out_Summary = &quot;==================== EMAIL AUTO-RESPONDER SUMMARY ====================&quot; &amp; nl &amp;&#xA;            &quot;Emails read from inbox ............ &quot; &amp; nRead.ToString() &amp; nl &amp;&#xA;            &quot;Help Desk emails .................. &quot; &amp; nHelp.ToString() &amp; &quot;   (other emails: &quot; &amp; (nRead - nHelp).ToString() &amp; &quot;)&quot; &amp; nl &amp;&#xA;            &quot;Spam detected ..................... &quot; &amp; nSpam.ToString() &amp; If(nSpam = 0, &quot;   (no spam detected)&quot;, &quot;   (moved to Trash)&quot;) &amp; nl &amp;&#xA;            &quot;Priority checked - urgent ......... &quot; &amp; nUrgent.ToString() &amp; &quot;   (normal priority: &quot; &amp; (nHelp - nUrgent).ToString() &amp; &quot;)&quot; &amp; nl &amp;&#xA;            &quot;Help Desk keywords matched ........ &quot; &amp; nKeyword.ToString() &amp; nl &amp;&#xA;            &quot;Personalised AI replies sent ...... &quot; &amp; nReplied.ToString() &amp; nl &amp;&#xA;            &quot;Directed to departments ........... &quot; &amp; nForward.ToString() &amp; If(deptText.Length &gt; 0, &quot;   (&quot; &amp; deptText.ToString() &amp; &quot;)&quot;, &quot;&quot;) &amp; nl &amp;&#xA;            &quot;Fallback / acknowledgement emails . &quot; &amp; nFallback.ToString() &amp; nl &amp;&#xA;            &quot;Status ............................ &quot; &amp; If(endRun.Value(Of String)(&quot;status&quot;), &quot;&quot;) &amp; nl &amp;&#xA;            &quot;Dashboard ......................... &quot; &amp; System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;dashboard&quot;, &quot;index.html&quot;) &amp; nl &amp;&#xA;            &quot;======================================================================&quot;&#xA;    Case &quot;email&quot;&#xA;        Dim mail As Newtonsoft.Json.Linq.JObject = Nothing&#xA;        For Each t As Newtonsoft.Json.Linq.JToken In emails&#xA;            If t.Value(Of String)(&quot;runId&quot;) = runKey AndAlso t.Value(Of String)(&quot;ticketId&quot;) = ticketKey Then mail = CType(t, Newtonsoft.Json.Linq.JObject)&#xA;        Next&#xA;        If mail Is Nothing Then&#xA;            mail = New Newtonsoft.Json.Linq.JObject()&#xA;            mail(&quot;runId&quot;) = runKey&#xA;            mail(&quot;ticketId&quot;) = ticketKey&#xA;            mail(&quot;receivedAt&quot;) = nowText&#xA;            emails.Add(mail)&#xA;        End If&#xA;        For Each p As Newtonsoft.Json.Linq.JProperty In fields.Properties()&#xA;            mail(p.Name) = p.Value&#xA;        Next&#xA;        mail(&quot;updatedAt&quot;) = nowText&#xA;    Case &quot;rules&quot;&#xA;        fields(&quot;loadedAt&quot;) = nowText&#xA;        data(&quot;rules&quot;) = fields&#xA;    Case &quot;excel&quot;&#xA;        ' Copy an Excel workbook (every sheet, every row) into the dashboard so the browser can show it like Excel.&#xA;        ' The .xlsx file is read directly (it is a zip of XML files), so Excel does not need to be open.&#xA;        Dim relPath As String = If(fields.Value(Of String)(&quot;path&quot;), &quot;audit\audit table.xlsx&quot;)&#xA;        Dim xlPath As String = System.IO.Path.Combine(System.Environment.CurrentDirectory, relPath)&#xA;        If data(&quot;workbooks&quot;) Is Nothing OrElse data(&quot;workbooks&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Object Then&#xA;            data(&quot;workbooks&quot;) = New Newtonsoft.Json.Linq.JObject()&#xA;        End If&#xA;        Dim book As New Newtonsoft.Json.Linq.JObject()&#xA;        book(&quot;path&quot;) = relPath&#xA;        book(&quot;readAt&quot;) = nowText&#xA;        If Not System.IO.File.Exists(xlPath) Then&#xA;            book(&quot;missing&quot;) = True&#xA;        Else&#xA;            Dim sheetList As New Newtonsoft.Json.Linq.JArray()&#xA;            Using fs As New System.IO.FileStream(xlPath, System.IO.FileMode.Open, System.IO.FileAccess.Read, System.IO.FileShare.ReadWrite Or System.IO.FileShare.Delete)&#xA;                Using zip As New System.IO.Compression.ZipArchive(fs, System.IO.Compression.ZipArchiveMode.Read)&#xA;                    Dim readXml As System.Func(Of String, System.Xml.Linq.XDocument) =&#xA;                        Function(entryName As String) As System.Xml.Linq.XDocument&#xA;                            Dim en As System.IO.Compression.ZipArchiveEntry = zip.GetEntry(entryName)&#xA;                            If en Is Nothing Then Return Nothing&#xA;                            Using st As System.IO.Stream = en.Open()&#xA;                                Return System.Xml.Linq.XDocument.Load(st)&#xA;                            End Using&#xA;                        End Function&#xA;                    Dim ns As System.Xml.Linq.XNamespace = &quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot;&#xA;                    Dim relNs As System.Xml.Linq.XNamespace = &quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships&quot;&#xA;                    Dim pkgNs As System.Xml.Linq.XNamespace = &quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;&#xA;&#xA;                    ' shared strings (the text values used by the sheets)&#xA;                    Dim sharedStrings As New System.Collections.Generic.List(Of String)()&#xA;                    Dim sst As System.Xml.Linq.XDocument = readXml(&quot;xl/sharedStrings.xml&quot;)&#xA;                    If sst IsNot Nothing Then&#xA;                        For Each si As System.Xml.Linq.XElement In sst.Root.Elements(ns + &quot;si&quot;)&#xA;                            Dim sb As New System.Text.StringBuilder()&#xA;                            For Each tEl As System.Xml.Linq.XElement In si.Descendants(ns + &quot;t&quot;)&#xA;                                sb.Append(tEl.Value)&#xA;                            Next&#xA;                            sharedStrings.Add(sb.ToString())&#xA;                        Next&#xA;                    End If&#xA;&#xA;                    Dim wb As System.Xml.Linq.XDocument = readXml(&quot;xl/workbook.xml&quot;)&#xA;                    Dim rels As System.Xml.Linq.XDocument = readXml(&quot;xl/_rels/workbook.xml.rels&quot;)&#xA;                    For Each sh As System.Xml.Linq.XElement In wb.Root.Element(ns + &quot;sheets&quot;).Elements(ns + &quot;sheet&quot;)&#xA;                        Dim nm As String = CStr(sh.Attribute(&quot;name&quot;))&#xA;                        Dim rid As String = CStr(sh.Attribute(relNs + &quot;id&quot;))&#xA;                        Dim sheetPath As String = Nothing&#xA;                        For Each rel As System.Xml.Linq.XElement In rels.Root.Elements(pkgNs + &quot;Relationship&quot;)&#xA;                            If CStr(rel.Attribute(&quot;Id&quot;)) = rid Then&#xA;                                Dim target As String = CStr(rel.Attribute(&quot;Target&quot;))&#xA;                                If target.StartsWith(&quot;/&quot;) Then&#xA;                                    sheetPath = target.TrimStart(&quot;/&quot;c)&#xA;                                Else&#xA;                                    sheetPath = &quot;xl/&quot; &amp; target&#xA;                                End If&#xA;                            End If&#xA;                        Next&#xA;                        Dim ws As System.Xml.Linq.XDocument = Nothing&#xA;                        If sheetPath IsNot Nothing Then ws = readXml(sheetPath)&#xA;                        Dim outRows As New Newtonsoft.Json.Linq.JArray()&#xA;                        If ws IsNot Nothing AndAlso ws.Root.Element(ns + &quot;sheetData&quot;) IsNot Nothing Then&#xA;                            Dim rowCounter As Integer = 0&#xA;                            For Each rowEl As System.Xml.Linq.XElement In ws.Root.Element(ns + &quot;sheetData&quot;).Elements(ns + &quot;row&quot;)&#xA;                                rowCounter = rowCounter + 1&#xA;                                Dim rowNum As Integer = rowCounter&#xA;                                Dim rAttr As String = CStr(rowEl.Attribute(&quot;r&quot;))&#xA;                                If rAttr IsNot Nothing Then Integer.TryParse(rAttr, rowNum)&#xA;                                rowCounter = rowNum&#xA;                                Dim cells As New System.Collections.Generic.List(Of String)()&#xA;                                For Each cel As System.Xml.Linq.XElement In rowEl.Elements(ns + &quot;c&quot;)&#xA;                                    Dim refText As String = If(CStr(cel.Attribute(&quot;r&quot;)), &quot;&quot;)&#xA;                                    Dim colIdx As Integer = 0&#xA;                                    For Each ch As Char In refText&#xA;                                        If Char.IsLetter(ch) Then colIdx = colIdx * 26 + (AscW(Char.ToUpper(ch)) - 64)&#xA;                                    Next&#xA;                                    colIdx = colIdx - 1&#xA;                                    If colIdx &lt; 0 Then colIdx = cells.Count&#xA;                                    Dim cellKind As String = If(CStr(cel.Attribute(&quot;t&quot;)), &quot;n&quot;)&#xA;                                    Dim vEl As System.Xml.Linq.XElement = cel.Element(ns + &quot;v&quot;)&#xA;                                    Dim raw As String = If(vEl Is Nothing, &quot;&quot;, vEl.Value)&#xA;                                    Dim shown As String = raw&#xA;                                    If cellKind = &quot;s&quot; AndAlso raw &lt;&gt; &quot;&quot; Then&#xA;                                        shown = sharedStrings(CInt(raw))&#xA;                                    ElseIf cellKind = &quot;b&quot; Then&#xA;                                        shown = If(raw = &quot;1&quot;, &quot;TRUE&quot;, &quot;FALSE&quot;)&#xA;                                    ElseIf cellKind = &quot;inlineStr&quot; Then&#xA;                                 